# Postgres connection string. Run `psql -f db/schema.sql` against a fresh
# database to set up the required tables before starting the server.
POSTGRES_URI=postgres://user:password@localhost:5432/cinemastream

# Gmail account used to send OTP / password-reset emails via Nodemailer.
# Use a Gmail App Password, not the account's normal login password.
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-gmail-app-password

# Secrets used to sign access/refresh JWTs. Use long, random, distinct values
# (e.g. `openssl rand -hex 32`) -- do not reuse the same value for both.
JWT_SECRET=
REFRESH_SECRET=

# Port the Express server listens on.
PORT=5000

# Origin the frontend is served from -- must match exactly (scheme + host + port)
# for CORS with credentials to work.
CORS_ORIGIN=http://localhost:3000

# development | test | production
NODE_ENV=development
